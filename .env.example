# Configuración de Entorno - Plataforma Multiagente de Analítica Avanzada
# Por defecto se ejecuta en "Demostración sin LLM" determinista si GEMINI_API_KEY está vacía.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# Servidor Backend
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development
