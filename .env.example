# Environment Configuration - Adaptive Multi-Agent Analytics Platform
# By default, runs in deterministic "Demo Without LLM" mode if GEMINI_API_KEY is empty.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# Backend Server
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development
